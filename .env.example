# Example configuration. Copy to .env and replace every "change-me" value.
# .env is git-ignored; never commit real credentials.

# ----------------------------------------------------------
# NRW platform (iris_core) - used by docker-compose "postgres",
# app/database/session.py and the AI services
# ----------------------------------------------------------
POSTGRES_DB=nrw_dc_bi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5433/nrw_dc_bi
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4.1-mini

# pgAdmin (docker-compose "pgadmin")
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# ----------------------------------------------------------
# IRIS-WSG-TH: Thuringia water protection zones -> iris_staging
# Staging only. These variables are separate from DATABASE_URL on purpose.
# Use URL-safe characters (letters, digits, - _) in passwords.
# ----------------------------------------------------------
IRIS_ENVIRONMENT=development

# Isolated staging PostGIS (docker compose --profile wsg)
WSG_POSTGRES_PASSWORD=change-me-superuser
IRIS_STAGING_WRITER_PASSWORD=change-me-writer

# Staging connection used by "python -m app.water_protection load/init-db/check-db"
IRIS_STAGING_DATABASE_URL=postgresql+psycopg://iris_staging_writer:change-me-writer@127.0.0.1:5434/iris_staging_dev
IRIS_STAGING_ALLOWED_HOSTS=localhost,127.0.0.1,postgis-staging
# IRIS_STAGING_BATCH_SIZE=500

# Integration tests (database name must end in _test)
IRIS_TEST_DATABASE_URL=postgresql+psycopg://iris_staging_writer:change-me-writer@127.0.0.1:5434/iris_staging_test

# WFS source (defaults shown; the assignment's endpoint
# https://geoportal.thueringen.de/wfs/wsg with layer th_wsg_zonen is not reachable)
# WSG_WFS_URL=https://www.geoproxy.geoportal-th.de/geoproxy/services/wsg_hqsg_wfs
# WSG_LAYER=tmlnu:WASSER_UND_HEILQUELLENSCHUTZGEBIETE
# WSG_STATE_CODE=TH
# WSG_ACCEPT_VERSIONS=2.0.0,1.1.0
# WSG_CONNECT_TIMEOUT_S=10
# WSG_READ_TIMEOUT_S=120
# WSG_MAX_RETRIES=4
# WSG_BACKOFF_BASE_S=2
# WSG_BACKOFF_MAX_S=60
# WSG_MIN_REQUEST_INTERVAL_S=1
# WSG_PAGE_SIZE=500
# WSG_MAX_FEATURES=100000
# WSG_MAX_PAGES=1000
# WSG_MAX_RESPONSE_BYTES=209715200
# WSG_MAPPING_FILE=
# WSG_ALLOW_GEOMETRY_REPAIR=true
# WSG_MAX_REPAIR_AREA_CHANGE_RATIO=0.001
